<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abraham.aladi-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/abrahammathew/dev/aladi-catalogue/run_weekly.sh</string>
  </array>
  <!-- Sunday 07:30 — quiet hours for the library's OPAC. If the Mac is asleep,
       launchd runs the job once on next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/abrahammathew/dev/aladi-catalogue/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/abrahammathew/dev/aladi-catalogue/logs/launchd.log</string>
</dict>
</plist>
